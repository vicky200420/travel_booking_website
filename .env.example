# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# True for local development, False for production
DJANGO_DEBUG=True
# Comma-separated hostnames. Production example: your-app.onrender.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated full origins allowed to POST to the site (same as ALLOWED_HOSTS but with scheme+port).
# Production example: https://your-app.onrender.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------------------------------------------------------------------------
# CORS (API browser-origin access)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A (recommended for Render): single URL. Examples:
#   postgres://user:password@host:5432/dbname
#   sqlite:///db.sqlite3
DATABASE_URL=
# Option B: individual settings (fallback used when DATABASE_URL is empty)
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Cache (locmem by default; use Redis in production)
# ---------------------------------------------------------------------------
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://:password@host:6379/0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Payments (fill real values ONLY in your live .env / Render secrets, never here)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_PAYMENT_GATEWAY=razorpay
DEFAULT_CURRENCY=INR

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TravelBooking <no-reply@travelbooking.local>
SITE_NAME=TravelBooking
SITE_URL=http://127.0.0.1:8000
SUPPORT_EMAIL=support@travelbooking.local
SUPPORT_PHONE=+1 (800) 555-0199

# ---------------------------------------------------------------------------
# Transport security — production only (Render terminates TLS for you)
# ---------------------------------------------------------------------------
# Enable only behind HTTPS (e.g. Render's *.onrender.com or a custom domain).
DJANGO_USE_HTTPS=False
# HSTS max-age in seconds. Start low (e.g. 60), raise after verifying HTTPS works.
# DJANGO_HSTS_SECONDS=31536000
